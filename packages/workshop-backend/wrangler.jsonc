{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workshop-backend",
  "main": "src/server.ts",
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["experimental", "allow_irrevocable_stub_storage"],
  "services": [
    {
      "binding": "GATEKEEPER_GOOGLE",
      "service": "gatekeeper-google",
      "entrypoint": "GatekeeperVendor"
    },
    {
      "binding": "GATEKEEPER_EMAIL",
      "service": "gatekeeper-email",
      "entrypoint": "GatekeeperVendor"
    },
    {
      "binding": "GATEKEEPER_GITHUB",
      "service": "gatekeeper-github",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [ "AdminSettings" ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLUEPRINTS",
      "preview_id": "gadgets-blueprint-metadata"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLUEPRINT_CONTENT",
      "bucket_name": "gadgets-blueprint-content"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  // Having this binding configured forces people to log in when they run `wrangler dev`, so it's
  // disabled by default, but you should uncomment it if you want Workers AI.
  //
  "ai": {
    "binding": "WORKERS_AI"
  },

  // When deploying to prod, you may want to bundle the frontend as assets on the backend, like so.
  // But it's not the only way to do it.
  //
  // "assets": {
  //   "directory": "../workshop-frontend/dist",
  //   "not_found_handling": "single-page-application",
  //   "run_worker_first": ["/api"]
  // },
}
