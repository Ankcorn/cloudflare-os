{
  "name": "workshop-backend",
  "main": "src/server.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["experimental"],
  "services": [
    {
      "binding": "GATEKEEPER_GOOGLE",
      "service": "gatekeeper-google",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Wrangler doesn't currently think a DO class exists unless there's a binding to it. This
        // is a bug -- it should use "migrations" instead.
        "name": "DUMMY_UserDurableObject",
        "class_name": "UserDurableObject"
      },
      {
        // Wrangler doesn't currently think a DO class exists unless there's a binding to it. This
        // is a bug -- it should use "migrations" instead.
        "name": "DUMMY_OverseerDurableObject",
        "class_name": "OverseerDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    }
  ],
  "unsafe": {
		"bindings": [
			{
				"name": "LOADER",
				"type": "worker-loader"
			}
		]
	}
}