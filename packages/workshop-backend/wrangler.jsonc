{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workshop-backend",
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["experimental", "allow_irrevocable_stub_storage", "rpc_params_dup_stubs"],
  "services": [
    {
      "binding": "GATEKEEPER_GOOGLE",
      "service": "gatekeeper-google",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
// Workers AI doesn't really work right now, and having this binding configured forces people to
// log in when they run `wrangler dev`, so removing it for now.
//  "ai": {
//    "binding": "WORKERS_AI"
//  }
}