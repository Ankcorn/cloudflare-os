{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workshop-backend",
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["experimental", "allow_irrevocable_stub_storage", "rpc_params_dup_stubs"],
  "services": [
    {
      "binding": "GATEKEEPER_GOOGLE",
      "service": "gatekeeper-google",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "ai": {
    "binding": "WORKERS_AI"
  }
}