{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workshop-backend",
  "main": "src/server.ts",
  "compatibility_date": "2026-02-02",

  // `global_fetch_strictly_public` enables workerd's post-DNS IP-address filtering so that
  // outbound fetch() can only reach public IPs. This is the SSRF defense for the webFetch
  // agent tool (see packages/workshop-backend/src/web-fetch.ts). Note that `wrangler dev`
  // intentionally reconfigures its global outbound to permit fetching from any address
  // (so local services on localhost stay reachable), so this flag effectively only takes
  // effect in production. That's an acceptable tradeoff for dev.
  "compatibility_flags": [
    "experimental",
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public"
  ],

  // Gatekeeper service bindings and the Workers AI binding are dynamically
  // added by run-dev-server.js (for dev) and generate-wrangler-prod.js (for
  // production).

  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [ "AdminSettings" ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLUEPRINTS",
      "preview_id": "gadgets-blueprint-metadata"
    },
    {
      "binding": "AVATARS",
      "preview_id": "gadgets-avatars"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLUEPRINT_CONTENT",
      "bucket_name": "gadgets-blueprint-content"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  // When deploying to prod, you may want to bundle the frontend as assets on the backend, like so.
  // But it's not the only way to do it.
  //
  // "assets": {
  //   "directory": "../workshop-frontend/dist",
  //   "not_found_handling": "single-page-application",
  //   "run_worker_first": ["/api"]
  // },
}
