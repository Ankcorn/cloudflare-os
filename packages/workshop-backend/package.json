{
  "name": "@gadgets/workshop-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "types:check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.104",
    "@ai-sdk/google": "^3.0.103",
    "@ai-sdk/openai": "^3.0.90",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/typed-storage": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "ai": "^6.0.238",
    "ai-gateway-provider": "^3.2.0",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1",
    "diff": "^8.0.4",
    "jose": "^6.2.5",
    "ollama-ai-provider-v2": "^3.6.0",
    "workers-ai-provider": "^3.3.1",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
