{
  "name": "@gadgets/workshop-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "types:check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/typed-storage": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1",
    "diff": "^8.0.4",
    "jose": "^6.2.5",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
