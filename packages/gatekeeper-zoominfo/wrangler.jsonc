{
  "name": "gatekeeper-zoominfo",
  "main": ".wrangler/validate/src/zoominfo.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["experimental", "allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "ZoomInfoGatekeeperImpl"]
    }
  ]
}
