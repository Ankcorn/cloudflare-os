{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true,
    "paths": {
      "@gadgets/integration-tests/*": ["../integration-tests/src/*"]
    }
  },
  "include": ["src", "__tests__", "vite.bin.config.ts"],
  "exclude": ["node_modules"]
}
