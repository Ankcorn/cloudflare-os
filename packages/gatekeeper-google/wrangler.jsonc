{
  "name": "gatekeeper-google",
  "main": "src/google.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["experimental"],
  "durable_objects": {
    "bindings": [
      {
        // Wrangler doesn't currently think a DO class exists unless there's a binding to it. This
        // is a bug -- it should use "migrations" instead.
        "name": "DUMMY_UserAccount",
        "class_name": "UserAccount"
      },
      {
        // Wrangler doesn't currently think a DO class exists unless there's a binding to it. This
        // is a bug -- it should use "migrations" instead.
        "name": "DUMMY_GmailGatekeeperImpl",
        "class_name": "GmailGatekeeperImpl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserAccount", "GmailGatekeeperImpl" ]
    }
  ],
}