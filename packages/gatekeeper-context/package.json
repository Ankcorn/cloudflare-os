{
  "name": "@gadgets/gatekeeper-context",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "pnpm run build:app && wrangler deploy",
    "build:app": "node build-app.mjs",
    "build:app:watch": "node build-app.mjs --watch",
    "typecheck:app": "tsc -p tsconfig.app.json && tsc -p tsconfig.vite.json",
    "types:check": "pnpm run typecheck:app && pnpm run build:app && tsc --noEmit",
    "build": "pnpm run typecheck:app && pnpm run build:app && tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@gadgets/typed-storage": "workspace:*",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1",
    "isomorphic-git": "^1.38.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/kumo": "^2.2.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@emoji-mart/data": "^1.2.1",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "emoji-mart": "^5.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.92.0"
  }
}
