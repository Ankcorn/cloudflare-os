{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-webhook",
  "main": ".wrangler/validate/src/webhook.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WebhookDispatcher", "WebhookGatekeeper"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1, "logs": {"invocation_logs": false}}
}
