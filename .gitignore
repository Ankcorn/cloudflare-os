# Dependencies
node_modules/

# Build outputs
dist/
# Generated gatekeeper configurator UI bundles (built by build-gatekeeper-configurator.mjs).
# Other generated artifacts under src/generated/ (e.g. gatekeeper-context's committed app.txt) are
# intentionally tracked.
packages/gatekeeper-*/src/generated/*-configurator-ui.txt

# TypeScript build info
*.tsbuildinfo

# Cloudflare Workers
.wrangler/
.env

# Local dev secrets (loaded by run-dev-server.js)
.dev.vars*

# Site-specific production deployment configs.
wrangler.prod.jsonc

# Site-specific dev server configs.
wrangler.dev.jsonc

# macOS
.DS_Store

# Wrangler local dev secrets (never commit). Matches root and per-package .dev.vars files.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
