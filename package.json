{
  "name": "gadgets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run --recursive build",
    "test": "pnpm run --recursive --if-present test",
    "dev-client": "cd packages/workshop-frontend && pnpm run dev",
    "dev-server": "node run-dev-server.js",
    "clean": "pnpm run --recursive clean",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "types:check": "pnpm run --recursive --if-present types:check",
    "lint": "pnpm run lint:check && pnpm run types:check"
  },
  "devDependencies": {
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
